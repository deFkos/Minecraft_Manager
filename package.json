{
  "name": "neocraft-control",
  "private": true,
  "version": "1.0.0",
  "description": "Менеджер сервера Minecraft и автоустановщик клиента TLauncher (NeoForge 1.21.1)",
  "author": "NeoCraft Control",
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit",
    "electron:compile": "node scripts/build-electron.mjs --compile-only",
    "electron:build:win": "node scripts/build-electron.mjs --target=win",
    "electron:build:linux": "node scripts/build-electron.mjs --target=linux",
    "electron:build": "node scripts/build-electron.mjs --target=current"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
